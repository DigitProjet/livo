{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    

    /* Path mapping - MISE À JOUR IMPORTANTE */
    "baseUrl": ".",
    "paths": {
      "livo-types": ["../livo-types/dist"],
      "livo-types/*": ["../livo-types/dist/*"]
    }
  },
  "typeRoots": ["./node_modules/livo-types/dist", "./node_modules/@types"],
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}